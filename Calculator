#Calculator that takes multiple inputs and performs calculations based on which operations user chooses.

#Function that performs calculations depending on which operation user chooses
def calculator(number1,number2,operation):
    if operation=="+":
        return number1+number2
    elif operation=="-":
       return number1-number2
    elif operation=="*":
        return number1*number2
    elif operation=="%":
        return number1%number2
    elif operation=="**":
        return number1**number2
    elif operation=="/":
        if number2==0:
            print("Undefined")
            return None
        else:
            return number1/number2
    else:
        print("Invalid Response")
        return None

def get_number(prompt):
    while True:
        try:
            return float(input(prompt))
        except ValueError:
            print("Invalid Input")

    
#Main calculator loop
running=True
while running:
    result=get_number("Enter First Number: ")
    while True:
        operation=input("Choose an operation (+,-,*,/,**,%) or enter 'done':" ).strip().lower()
        if operation== "done":
            break
        if operation not in ("+","-","*","/","**","%"):
            print("Invalid Response")
            continue

        number=get_number("Enter Next Number: ")
        new_result=calculator(result, number, operation)

        if new_result is None:
            continue

        result=new_result
        print("Running Total:",result)

    print("Final Result:",result)


    #Replayability loop that prompts user for yes and no and restarts question if user does not enter valid answer
    while True:
        again=input("Would You Like To Calculate Again? (Yes/No):").split().lower()
        if again=="yes":
            break
        elif again=="no":
            running=False
            break
        else:
            print("Invalid Response. Please Try Again")



